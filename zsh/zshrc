# Sourced from ~/.zshrc. zsh is the macOS default; this mirrors bash/bashrc.
DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

source "$DOTFILES/shell/envs.sh"

[[ -o interactive ]] || return

# Emacs line editing. zsh defaults to vi mode when EDITOR contains "vi" (nvim does),
# which changes Ctrl+A/E/R/W and the arrow keys. bash and Omarchy use emacs mode.
bindkey -e

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=32768
SAVEHIST=32768
setopt APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# Completion, case-insensitive, menu-style (matches the bash inputrc feel)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select

# Arrow keys search history with what you've typed so far
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search   # application-mode variant, sent inside tmux
bindkey '^[OB' down-line-or-beginning-search

source "$DOTFILES/shell/aliases.sh"
source "$DOTFILES/shell/functions.sh"

command -v mise &> /dev/null && eval "$(mise activate zsh)"
command -v starship &> /dev/null && [[ ${TERM:-} != "dumb" ]] && eval "$(starship init zsh)"
command -v zoxide &> /dev/null && eval "$(zoxide init zsh)"
command -v fzf &> /dev/null && eval "$(fzf --zsh)"
